---
const path = Astro.url.pathname;
const links = [
  { href: '/soluciones/',     label: 'soluciones' },
  { href: '/integraciones/',  label: 'integraciones' },
  { href: '/casos/',          label: 'casos' },
  { href: '/infraestructura/', label: 'infraestructura' },
];
---
<header class="nav" id="main-nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="NioSystems">
      <img src="/favicon.svg" alt="" width="26" height="26" class="brand-mark" />
      <span>NioSystems</span>
    </a>
    <div class="nav-right">
      <nav aria-label="Principal" class="nav-links">
        {links.map(({ href, label }) => (
          <a href={href} class:list={[{ 'is-active': path.startsWith(href) }]} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <button class="theme-toggle" aria-label="Cambiar a tema claro" aria-pressed="false" type="button">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href="/#contacto" class="btn btn-primary nav-cta">Diagnóstico gratuito</a>
      <button class="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" type="button">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navegación">
      {links.map(({ href, label }) => (
        <a href={href} class:list={['mobile-link', { 'is-active': path.startsWith(href) }]} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="mobile-menu-foot">
      <a href="/#contacto" class="btn btn-primary" style="width: 100%; justify-content: center;">Diagnóstico gratuito</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('main-nav');
    const menu = document.getElementById('mobile-menu');
    const hamburger = nav.querySelector('.hamburger');
    const themeBtn = nav.querySelector('.theme-toggle');

    const behind = () => document.querySelectorAll('main, footer');

    function openMenu() {
      behind().forEach(el => el.setAttribute('inert', ''));
      hamburger.setAttribute('aria-expanded', 'true');
      menu.removeAttribute('hidden');
      nav.classList.add('menu-open');
    }
    function closeMenu() {
      behind().forEach(el => el.removeAttribute('inert'));
      hamburger.setAttribute('aria-expanded', 'false');
      menu.setAttribute('hidden', '');
      nav.classList.remove('menu-open');
    }

    hamburger.addEventListener('click', () => {
      nav.classList.contains('menu-open') ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target)) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    function syncThemeBtn() {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      themeBtn.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
      themeBtn.setAttribute('aria-pressed', String(!dark));
    }
    syncThemeBtn();

    // Curva cubic-bezier(.4, 0, .2, 1): devuelve en qué fracción del tiempo la onda alcanza un progreso dado
    function timeAtProgress(progress) {
      const x1 = .4, y1 = 0, x2 = .2, y2 = 1;
      const bez = (a, b, c, s) => 3 * a * s * (1 - s) * (1 - s) + 3 * b * s * s * (1 - s) + s * s * s;
      let lo = 0, hi = 1;
      for (let i = 0; i < 24; i++) {
        const mid = (lo + hi) / 2;
        if (bez(y1, y2, 1, mid) < progress) lo = mid; else hi = mid;
      }
      return bez(x1, x2, 1, (lo + hi) / 2);
    }

    // Onda de choque: cada bloque de texto recibe un empujón corto, hacia afuera, cuando el frente lo alcanza
    function shakeText(ox, oy, radius, duration) {
      const parents = new Set();
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: n => n.nodeValue.trim() && !['SCRIPT', 'STYLE'].includes(n.parentElement.tagName)
          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
      });
      while (walker.nextNode()) parents.add(walker.currentNode.parentElement);
      const targets = [...parents].filter(el => ![...parents].some(o => o !== el && o.contains(el)));

      targets.forEach(el => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight || r.right < 0 || r.left > innerWidth) return;
        const dx = r.left + r.width / 2 - ox;
        const dy = r.top + r.height / 2 - oy;
        const dist = Math.hypot(dx, dy) || 1;
        if (dist > radius) return;
        const ux = dx / dist, uy = dy / dist;
        const delay = timeAtProgress(dist / radius) * duration;
        el.animate(
          [
            { translate: '0 0' },
            { translate: `${ux * 3}px ${uy * 3}px`, offset: .3 },
            { translate: `${-ux * 1.2}px ${-uy * 1.2}px`, offset: .65 },
            { translate: '0 0' },
          ],
          { duration: 320, delay, easing: 'ease-out' }
        );
      });
    }

    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      const apply = () => {
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncThemeBtn();
      };

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduce) { apply(); return; }

      // Onda radial desde el botón: el tema nuevo se revela como un círculo creciente
      const r = themeBtn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      const DURATION = 600;
      const transition = document.startViewTransition(apply);
      transition.ready.then(() => {
        document.documentElement.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: DURATION, easing: 'cubic-bezier(.4, 0, .2, 1)', pseudoElement: '::view-transition-new(root)' }
        );
        shakeText(x, y, radius, DURATION);
      }).catch(() => {});
    });
  })();
</script>
