---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Filosofia from '../components/Filosofia.astro';
import Servicios from '../components/Servicios.astro';
import EstadoNioberp from '../components/EstadoNioberp.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://nio.gt/#org',
  name: 'NioSystems',
  url: 'https://nio.gt/',
  image: 'https://nio.gt/og-default.png',
  email: 'hola@nio.gt',
  telephone: '+502 5515 5215',
  logo: 'https://nio.gt/favicon.svg',
  address: { '@type': 'PostalAddress', addressLocality: 'Jutiapa', addressCountry: 'GT' },
  location: { '@type': 'Place', name: 'Jutiapa, Guatemala', geo: { '@type': 'GeoCoordinates', latitude: 14.2915, longitude: -89.8956 } },
  knowsAbout: ['Odoo', 'ERP', 'FEL/DTE Guatemala', 'Migración de Odoo', 'Integraciones logísticas', 'Hosting Odoo'],
  sameAs: [
    'https://www.linkedin.com/company/niosystems/',
    'https://github.com/niosystems',
    'https://www.instagram.com/nio.systems/',
    'https://www.facebook.com/nio.systems.gt',
  ],
  areaServed:['GT', 'SV', 'HN', 'NI', 'CR', 'PA'],
  description: 'Consultoría Odoo ERP y desarrollo a medida para Guatemala y LATAM. Localización fiscal FEL/DTE, IGSS e ISR.',
};
---
<Base
  title="Odoo Guatemala: implementación, migración y rescate | NioSystems"
  description="Consultoría Odoo en Guatemala: implementación con FEL/DTE, migración de versiones, rescate de instancias y hosting propio. Primero diagnosticamos, sin costo."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Nav />
  <main>
    <Hero />
    <Filosofia />
    <Servicios />
    <EstadoNioberp />
    <Contacto />
  </main>
  <Footer />
</Base>